# Copy to .env and fill in per deployment. Each environment (training / live)
# runs its own instance of this middleware behind Apache, on its own internal
# port — see deploy/README.md for the Apache vhost + systemd setup.

# training | production — must match which vhost/instance this is.
# The middleware cross-checks this against the X-KIMS-Environment header the
# Flutter app sends and rejects the request if they don't match, so an
# operator can never accidentally point a Training-mode session at prod data
# or vice versa.
KIMS_ENV=training

# Internal port Node listens on (plain HTTP — Apache terminates TLS in front
# of this). Training and prod each get their own port on the same host.
PORT=3901

# demo | businessCentral | hybrid — which DataSource adapter to use.
#   demo            — everything in-memory demo data.
#   hybrid          — the real mode for a phased rollout. Individual
#                      methods route to Business Central per their own
#                      flag (see PUT_AWAY_READ_SOURCE below); everything
#                      else stays on demo data automatically. Use this,
#                      not businessCentral directly, whenever only SOME
#                      of the app has been migrated.
#   businessCentral — routes EVERYTHING at once. Only safe once every
#                      module's methods are actually implemented against
#                      Business Central — currently breaks Transfer,
#                      Quarantine, Pick, and everything else that hasn't
#                      been migrated yet.
DATA_SOURCE=demo

# Only read when DATA_SOURCE=hybrid. Routes Put Away's read methods
# (getPutAwayDocuments/getPutAwayDocument) specifically. demo | businessCentral.
PUT_AWAY_READ_SOURCE=demo

# Only read when DATA_SOURCE=hybrid. Routes Put Away's confirmPutAwayItem
# AND the whole-document Register event (Microsoft.NAV.Register) —
# INDEPENDENT of PUT_AWAY_READ_SOURCE above on purpose. demo |
# businessCentral. Reading from Business Central is low-risk (nothing
# changes); confirming WRITES to a live inventory system via PATCH
# .../putAwayLines. Verify reads are correct before ever setting this to
# businessCentral.
PUT_AWAY_CONFIRM_SOURCE=demo

# Only read when DATA_SOURCE=hybrid. Routes Stop & Split's capacity check
# (validatePutAwayBin/suggestPutAwayBin) — its own flag, independent of
# the two above. demo | businessCentral. Setting this to businessCentral
# TODAY has no effect: both are still _notImplemented() in
# businessCentralDataSource.js, since the documented /Bins endpoint has
# no capacity field to check against. This flag exists now so that once
# someone implements them for real, flipping this one value is the ONLY
# remaining step — no code change needed anywhere else.
PUT_AWAY_SPLIT_SOURCE=demo

# Only read when DATA_SOURCE=hybrid. Bin Inquiry is its own module,
# independent of Put Away entirely — not tied to the flags above, except
# that check-bin (bin-first assignment for an unassigned line) is ALSO
# routed by this one, not PUT_AWAY_CONFIRM_SOURCE — it's genuinely the
# same GET /Bins lookup Bin Inquiry uses, not a Put Away write. demo |
# businessCentral. Read-only, so there's no separate confirm side.
# IMPORTANT: even set to businessCentral, this only returns real bin
# METADATA (location, zone, type, description, empty/occupied) — Business
# Central has no documented endpoint for bin CONTENTS (what's actually
# sitting in it), so that part of the response stays empty with
# contentsAvailable: false rather than silently looking like the bin is
# physically empty.
BIN_INQUIRY_SOURCE=demo

# JWT signing secret. Generate a strong random value per deployment, e.g.:
#   openssl rand -base64 48
# Never reuse the same secret between training and production.
JWT_SECRET=9RzOedOgG8kRxI2J1zTgxu0YTuKF6iHpLxwppVkhqKX/+xhXMSdBIBvtPFgRkk7Y
JWT_EXPIRES_IN=12h

# Path to the local user store (JSON file) used until Business Central /
# Azure AD auth is wired up. Keep this outside the repo in production.
USER_STORE_PATH=./data/users.json

# Path to the scan-exception audit log (JSON file) — wrong item / wrong bin /
# unrecognized item scans pushed from Put Away, Pick, and Verify. Independent
# of DATA_SOURCE; this is middleware-generated audit data, not Business
# Central data. Keep this outside the repo in production, same as above.
SCAN_EXCEPTION_STORE_PATH=./data/scan-exceptions.json

# Comma-separated list of allowed CORS origins. The Flutter app doesn't run
# in a browser so this mainly matters if you ever add a web/admin client.
CORS_ORIGINS=

# --- Business Central ---
# Only required when Business Central is actually in use — either
# DATA_SOURCE=businessCentral outright, or DATA_SOURCE=hybrid with
# PUT_AWAY_READ_SOURCE=businessCentral. The app fails loudly at boot if
# any of the four are missing in that case, same as JWT_SECRET. A
# demo-only deployment never touches these and can leave them blank.
#
# Authentication is HTTP BASIC AUTH, not OAuth2 — see the KIMS-WM API
# Endpoint Reference doc (Section 1, Authentication). BC_USERNAME/
# BC_PASSWORD are the Business Central WEB SERVICE ACCESS username and
# Access Key issued by the BC administrator — NOT a normal BC portal login.
# Never commit real values here; this file is a template.

# Base URL of the Business Central OData Web Service — NO trailing slash,
# and NO company segment (that's appended per-request from BC_COMPANY_ID
# below). Same value for both training and production; only the company
# GUID differs between them.
BC_BASE_URL=

# THIS DEPLOYMENT'S OWN company GUID — training's .env gets the training
# company, production's .env gets the production company. Each deployment
# is already pinned to one environment via KIMS_ENV above; this follows
# that same one-.env-per-environment convention, not a runtime switch
# between two GUIDs in a single deployment.
BC_COMPANY_ID=

BC_USERNAME=
BC_PASSWORD=
