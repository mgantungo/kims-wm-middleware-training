# Copy to .env and fill in per deployment. Each environment (training / live)
# runs its own instance of this middleware behind Apache, on its own internal
# port — see deploy/README.md for the Apache vhost + systemd setup.

# training | production — must match which vhost/instance this is.
# The middleware cross-checks this against the X-KIMS-Environment header the
# Flutter app sends and rejects the request if they don't match, so an
# operator can never accidentally point a Training-mode session at prod data
# or vice versa.
KIMS_ENV=training

# Internal port Node listens on (plain HTTP — Apache terminates TLS in front
# of this). Training and prod each get their own port on the same host.
PORT=3901

# demo | businessCentral | hybrid — which DataSource adapter to use.
# hybrid is the correct mode for a phased rollout: Put Away's read path
# below routes to Business Central while Transfer, Quarantine, Pick, and
# everything else stays on demo data automatically. DATA_SOURCE=
# businessCentral directly routes EVERYTHING at once and breaks every
# module that hasn't been migrated yet — that's what was happening before
# this change.
DATA_SOURCE=hybrid

# Only read when DATA_SOURCE=hybrid. Routes Put Away's
# getPutAwayDocuments/getPutAwayDocument specifically; every other method
# (confirm, validate-bin, suggest-bin, check-bin, and all other modules)
# stays on demo regardless of this value until it gets its own phase.
PUT_AWAY_READ_SOURCE=businessCentral
PUT_AWAY_CONFIRM_SOURCE=businessCentral
BIN_INQUIRY_SOURCE=businessCentral
PUT_AWAY_SPLIT_SOURCE=businessCentral
PICK_CONFIRM_SOURCE=businessCentral
PICK_READ_SOURCE=businessCentral
ITEM_INQUIRY_SOURCE=businessCentral

# JWT signing secret. Generate a strong random value per deployment, e.g.:
#   openssl rand -base64 48
# Never reuse the same secret between training and production.
JWT_SECRET=9RzOedOgG8kRxI2J1zTgxu0YTuKF6iHpLxwppVkhqKX/+xhXMSdBIBvtPFgRkk7Y
JWT_EXPIRES_IN=12h

# Path to the local user store (JSON file) used until Business Central /
# Azure AD auth is wired up. Keep this outside the repo in production.
USER_STORE_PATH=./data/users.json

# Path to the scan-exception audit log (JSON file) — wrong item / wrong bin /
# unrecognized item scans pushed from Put Away, Pick, and Verify. Independent
# of DATA_SOURCE; this is middleware-generated audit data, not Business
# Central data. Keep this outside the repo in production, same as above.
SCAN_EXCEPTION_STORE_PATH=./data/scan-exceptions.json

# Comma-separated list of allowed CORS origins. The Flutter app doesn't run
# in a browser so this mainly matters if you ever add a web/admin client.
CORS_ORIGINS=

# --- Business Central ---
# Required here since PUT_AWAY_READ_SOURCE=businessCentral above puts
# Business Central actually in use.
#
# Authentication is HTTP BASIC AUTH, not OAuth2 — BC_USERNAME/BC_PASSWORD
# are the Business Central Web Service Access username and Access Key.
#102.216.144.5
#BC_BASE_URL=http://197.221.147.130:7048/KLL/api/KLL/WH/v2.0
#BC_BASE_URL=http://102.216.144.5:7048/KLL/api/KLL/WH/v2.0
#BC_BASE_URL=http://197.221.147.130:7048/KLL/api/KLL/WH/v2.0,http://102.216.144.5:7048/KLL/api/KLL/WH/v2.0
#check fallback
#BC_FAILBACK_MINUTES=5
BC_BASE_URL=BC_BASE_URL=http://erp.klanlogistics.com:7048/KLL/api/kll/wh/v2.0

# Training company GUID. Production's .env should have
# BC_COMPANY_ID=557f77cd-2f2a-ef11-8eb2-e4e84e40a5d4 instead — never both
# in the same file; each deployment is already pinned to one environment
