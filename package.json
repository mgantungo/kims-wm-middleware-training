{
  "name": "kims-wm-middleware",
  "version": "1.0.0",
  "description": "KIMS-WM Node.js middleware — sits between the Flutter app and Business Central. Currently backed by a demo data adapter; swaps to the real Business Central adapter in Phase 2 without touching route/controller code.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:users": "node scripts/seedUsers.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0"
  },
  "devDependencies": {
    "pino-pretty": "^11.0.0"
  }
}
